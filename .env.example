# Copy to .env for local overrides. Every value below is a DEV-ONLY default.
# All config comes from env; nothing is hard-coded in services.

NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0

# Service ports
GATEWAY_PORT=3000
CORE_API_PORT=3001
LOCATION_PORT=3002
DISPATCH_PORT=3003
PRICING_PORT=3004
PAYMENT_PORT=3005

# Postgres 16 (one server, four databases; see infra/postgres/init.sql)
POSTGRES_USER=hex
POSTGRES_PASSWORD=hex_dev_only
CORE_DATABASE_URL=postgres://hex:hex_dev_only@localhost:5432/core
DISPATCH_DATABASE_URL=postgres://hex:hex_dev_only@localhost:5432/dispatch
PRICING_DATABASE_URL=postgres://hex:hex_dev_only@localhost:5432/pricing
PAYMENT_DATABASE_URL=postgres://hex:hex_dev_only@localhost:5432/payment

# Redis 7
REDIS_URL=redis://localhost:6379

# Kafka API (Redpanda). Host access is localhost:19092; containers use redpanda:9092.
KAFKA_BROKERS=localhost:19092

# Auth (replace in any shared environment)
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600

# Geo
H3_CELL_RES=8
H3_MATCHER_OWNER_RES=6

# Dispatch (Phase 3+)
MATCHING_POLICY=greedy
MATCHING_SPEED_MPS=8.33
MATCHING_MAX_PICKUP_ETA_SEC=600
OFFER_TTL_SEC=15

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
