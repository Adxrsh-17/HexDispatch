    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": { "text": "BALANCED (Invariants Hold)" },
                "1": { "text": "DRIFT DETECTED" }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 11,
      "title": "Double-Entry Ledger Integrity Status",
      "type": "stat",
      "targets": [
        {
          "expr": "vector(0)",
