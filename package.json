{
  "name": "hexdispatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ride-sharing dispatch backend: batched H3-sharded matching, surge control loop, idempotent payments saga, seeded city simulator.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "pnpm --filter @hexdispatch/simulator start",
    "chaos": "tsx tools/chaos/runner.ts",
    "bench:load": "tsx tools/load-tests/run-all-load-tests.ts",
    "demo": "tsx tools/scripts/demo.ts"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.17.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.14",
    "drizzle-orm": "^0.45.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "fastify": "^5.2.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "ioredis-mock": "^8.13.1",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "prettier": "^3.4.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0",
    "ws": "^8.22.1"
  }
}
